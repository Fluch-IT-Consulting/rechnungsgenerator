%% Die Grundlage jeder Vorlage (ADR-0022): nur, was ein Design nicht anders setzen darf, ohne falsch zu werden.
%% Kein Platzhalter und kein Makro aus TemplateMacro, das prüft Template.of. Was hier geladen wird, lädt die
%% Vorlage nicht noch einmal: pdfx samt hyperref und xcolor, fontspec, siunitx, longtable, lastpage, refcount.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{grundlage}

%% pdfx muss vor allem anderen stehen, deshalb lädt jede Vorlage die Grundlage direkt nach \documentclass.
%% Ohne Lesezeichen: Die leere .out von hyperref verlangte sonst einen zweiten Lauf ohne Grund (#321). Als
%% Ladeoption, ein \hypersetup nach pdfx käme zu spät. xcolor lädt pdfx selbst; noch einmal mit Optionen
%% geladen, gäbe es einen „Option clash“.
\PassOptionsToPackage{bookmarks=false}{hyperref}
\RequirePackage[a-1b]{pdfx}

%% Ligatures=TeXOff: Sonst zöge fontspec „--“, „<<“ oder zwei Hochkommas aus den Eingabedaten zu einem Zeichen
%% zusammen; in escapeLatex aufbrechen geht nachgemessen nicht (#81). Mit den Familien in eckigen Klammern,
%% weil fontspec.cfg Ligatures=TeX eigens für \rmfamily und \sffamily setzt – ohne sie wirkt die Zeile nicht.
\RequirePackage{fontspec}
\defaultfontfeatures[\rmfamily,\sffamily]{Ligatures=TeXOff}

%% Die Einstellungen, ohne die siunitx still eine falsche Zahl setzte (ADR-0021):
%%  - mode=text: sonst Ziffern aus der Mathematikschrift statt aus der des Designs.
%%  - group-digits=integer: nach dem Komma nie getrennt, sonst stünde 0,033.5 für 0,0335.
%%  - round-mode=none, die Vorgabe, steht trotzdem da: Beim Setzen wird nie gerundet (#14).
%%  - reset-text-…=false: sonst fiele eine Zahl aus dem Fettdruck ihrer Zeile.
\RequirePackage{siunitx}
\sisetup{
  mode              = text,
  group-digits      = integer,
  round-mode        = none,
  reset-text-series = false,
  reset-text-shape  = false,
  reset-text-family = false,
}

%% Nach Punkt, Doppelpunkt und Komma der gewöhnliche Wortzwischenraum (#143): Aus den Eingabedaten lässt sich
%% nicht ablesen, wo ein Satz endet („Dr. Erika“, „14. August“). Den breiten bekommt nur \programmsatz.
\frenchspacing
%% Auch in Kopf und Fuß: amsgen, von siunitx geladen, setzt den \sfcode des Punkts auf 1006, und LaTeX hielte
%% das für \nonfrenchspacing (#353). Deshalb nach siunitx.
\let\normalsfcodes\frenchspacing

%% Nur für die eigenen Sätze des Programms: Eine Abkürzung aus den Eingabedaten bekäme sonst den breiten
%% Abstand. Nach : ; , nie, das sind keine Satzenden.
\newcommand{\programmsatz}[1]{{\nonfrenchspacing\sfcode`\:=1000 \sfcode`\;=1000 \sfcode`\,=1000 #1}}

%% Ein Absatz, der nicht über zwei Seiten bricht (ADR-0020). Er endet im Makro, weil \interlinepenalty beim
%% Brechen zählt, nicht beim Beginn. Ohne Satzabstand, damit ihn auch Eingabedaten bekommen.
\newcommand{\ungeteilt}[1]{{\interlinepenalty=10000 #1\par}}

%% Nur auf einer Seite, der eine weitere folgt (ADR-0020). An der Seite und nicht an der Tabelle: Die bricht
%% nicht um, wenn nur der Rest nicht mehr passt. Im ersten Lauf fehlt er, den zweiten verlangt LastPage.
\RequirePackage{lastpage}
\RequirePackage{refcount}
\newcommand{\wennweitereseite}[1]{\ifnum\value{page}<\getpagerefnumber{LastPage}\relax #1\fi}

%% LTchunksize so groß, dass jede Rechnung ein Block ist: Dann sind die Spalten auf jeder Seite gleich breit.
\RequirePackage{longtable}
\setcounter{LTchunksize}{10000}

\endinput
