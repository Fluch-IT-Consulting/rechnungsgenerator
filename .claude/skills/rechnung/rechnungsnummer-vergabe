#!/usr/bin/env python3
"""Vergabeskript: nennt die nächste Rechnungsnummer (ADR-0031).

Diese Datei ist die Vorlage. Kopiert nach .rechnungsgenerator/ in der Wurzel
der Ablage und mit den zwei Zeilen unten ausgefüllt, ruft sie
naechste-nummer.py aus dem rechnung-Skill auf:

    printf 'R26-011\\nR26-012\\n' | rechnungsnummer-vergabe 2026-11-16
    R26-013

stdin:    die belegten Rechnungsnummern, eine je Zeile. Was nicht in den
          Nummernkreis des Rechnungsdatums passt, wird übergangen.
Argument: das Rechnungsdatum als JJJJ-MM-TT.
stdout:   die nächste Nummer: die höchste des Nummernkreises plus eins, ohne
          belegte Nummer die erste. Lücken werden nicht aufgefüllt.

Ein eigenes Vergabeskript, gleich in welcher Sprache, hält sich an dasselbe
und dazu an zwei Bedingungen: Derselbe Aufruf ergibt dieselbe Nummer, und ohne
belegte Nummern nennt es die erste des Nummernkreises. Ob die Nummer schon
vergeben ist und ob sie bestätigt werden muss, entscheidet naechste-nummer.py.
"""
import argparse
import datetime
import re
import sys

# Zwei Zeilen tragen ein, wie die eigenen Rechnungsnummern aussehen. %y, %Y
# und %m stehen für das Rechnungsdatum und bestimmen den Nummernkreis. Danach
# ist NUMMERNKREIS ein regulärer Ausdruck, dessen Klammer der Zähler ist, und
# FORMAT macht aus dem Zähler die Nummer.
#
#               NUMMERNKREIS           FORMAT
# R26-012       r"R%y-(\d{3})"         "R%y-{:03d}"
# 2026-0042     r"%Y-(\d{4})"          "%Y-{:04d}"
# 2026-07-002   r"%Y-%m-(\d{3})"       "%Y-%m-{:03d}"
# RE-1042       r"RE-(\d{4})"          "RE-{:04d}"
# 0008/2026     r"(\d{4})/%Y"          "{:04d}/%Y"
NUMMERNKREIS = r""
FORMAT = ""


class Refusal(Exception):
    pass


def with_date(text: str, invoice_date: datetime.date) -> str:
    values = {
        "%y": f"{invoice_date.year % 100:02d}",
        "%Y": f"{invoice_date.year:04d}",
        "%m": f"{invoice_date.month:02d}",
    }
    return re.sub(r"%[yYm]", lambda m: values[m.group(0)], text)


def counter_of(series: "re.Pattern[str]", number: str) -> "int | None":
    match = series.fullmatch(number)
    return int(match.group(1)) if match and match.group(1).isdecimal() else None


def number_for(series: "re.Pattern[str]", number_format: str, counter: int) -> str:
    """Die Nummer zum Zähler; widersprechen sich die zwei Zeilen dabei, ein Abbruch."""
    try:
        number = number_format.format(counter)
    except (IndexError, KeyError, ValueError) as error:
        raise Refusal(f"FORMAT '{FORMAT}' lässt sich nicht mit einem Zähler füllen: {error}")
    if counter_of(series, number) == counter:
        return number
    if counter == 1:
        raise Refusal(
            f"NUMMERNKREIS '{NUMMERNKREIS}' und FORMAT '{FORMAT}' widersprechen sich: Die erste Nummer wäre "
            f"{number}, und NUMMERNKREIS liest daraus nicht den Zähler 1."
        )
    raise Refusal(
        f"Der Nummernkreis ist erschöpft: Die nächste Nummer wäre {number}, und sie passt nicht mehr "
        f"zu NUMMERNKREIS '{NUMMERNKREIS}'."
    )


def next_number(taken: list[str], invoice_date: datetime.date) -> str:
    if not NUMMERNKREIS or not FORMAT:
        raise Refusal(
            f"Die Vorlage ist noch nicht ausgefüllt: In {__file__} gehören NUMMERNKREIS und FORMAT eingetragen."
        )
    try:
        series = re.compile(with_date(NUMMERNKREIS, invoice_date))
    except re.error as error:
        raise Refusal(f"NUMMERNKREIS '{NUMMERNKREIS}' ist kein regulärer Ausdruck: {error}")
    if series.groups != 1:
        raise Refusal(f"NUMMERNKREIS '{NUMMERNKREIS}' braucht genau eine Klammer, den Zähler.")
    number_format = with_date(FORMAT, invoice_date)

    number_for(series, number_format, 1)
    counters = [c for c in (counter_of(series, line) for line in taken) if c is not None]
    return number_for(series, number_format, max(counters) + 1 if counters else 1)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("invoice_date", metavar="rechnungsdatum", type=datetime.date.fromisoformat)
    args = parser.parse_args()
    try:
        print(next_number(sys.stdin.read().splitlines(), args.invoice_date))
    except Refusal as refusal:
        print(refusal, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
